# This is a source repository inside an existing development workspace.
# Keep local installations, saves, downloads and source assets in place.
# New top-level directories are private until explicitly admitted below.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/AGENTS.md
!/neoforge-1.21.1/
!/scripts/
!/model-workflows/
!/docs/

# Admit the actual mod sources and build definition, not its runtime instances.
/neoforge-1.21.1/*
!/neoforge-1.21.1/.gitignore
!/neoforge-1.21.1/.gitattributes
!/neoforge-1.21.1/build.gradle
!/neoforge-1.21.1/settings.gradle
!/neoforge-1.21.1/gradle.properties
!/neoforge-1.21.1/gradlew
!/neoforge-1.21.1/gradlew.bat
!/neoforge-1.21.1/TEMPLATE_LICENSE.txt
!/neoforge-1.21.1/gradle/
!/neoforge-1.21.1/src/
/neoforge-1.21.1/gradle/*
!/neoforge-1.21.1/gradle/wrapper/
/neoforge-1.21.1/gradle/wrapper/*
!/neoforge-1.21.1/gradle/wrapper/gradle-wrapper.jar
!/neoforge-1.21.1/gradle/wrapper/gradle-wrapper.properties

# Commit final resources. Keep editable art projects and datagen caches local.
/neoforge-1.21.1/src/**/*.bbmodel
!/neoforge-1.21.1/scripts/
/neoforge-1.21.1/scripts/*
!/neoforge-1.21.1/scripts/create-client-snapshot.ps1
!/neoforge-1.21.1/libs/
/neoforge-1.21.1/libs/*
!/neoforge-1.21.1/libs/tacz-neoforge-1.21.1-1.1.8-hotfix-r7.jar
!/neoforge-1.21.1/libs/LesRaisins-Tactical-Equipements-1.21.1-0.4.3.jar
!/neoforge-1.21.1/libs/neoforge-carpet-1.21.1-1.0.8+v251027.jar
!/neoforge-1.21.1/libs/commons-math3-3.6.1.jar
!/neoforge-1.21.1/libs/luaj-core-3.0.8-figura.jar
!/neoforge-1.21.1/libs/simplebedrockmodel-2.2.1-neoforge+mc1.21.1.jar
!/neoforge-1.21.1/libs/xaerominimap-neoforge-1.21.1-26.6.0.jar
!/neoforge-1.21.1/libs/xaeroworldmap-neoforge-1.21.1-1.47.0.jar
!/neoforge-1.21.1/libs/xaerolib-neoforge-1.21.1-1.7.3.jar
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/mod-jar.yml

# Offline tools are source; downloaded tools, outputs and backup copies are not.
/model-workflows/*
!/model-workflows/.gitignore
!/model-workflows/README.md
!/model-workflows/requirements.txt
!/model-workflows/*.py
!/model-workflows/*.mjs

# Retain authored maintenance notes and the publication/dependency manifests.
# Third-party tutorials, API mirrors and raw gunpack fixtures remain local.
/docs/*
!/docs/*.md
/docs/NeoForge-1.21.1-开发教程全集.md
/docs/TaCZ-官方附属制作教程.md
!/docs/repository/
!/docs/gun-balance/
!/docs/compatibility/
/docs/gun-balance/*
!/docs/gun-balance/*.md
/docs/compatibility/*
!/docs/compatibility/*.md

# Never accidentally publish local credentials, environments or generated files.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/secrets.json
**/__pycache__/
**/*.pyc
**/.venv/
**/node_modules/
**/.DS_Store
**/src/generated/**/.cache/
